{
  "name": "@propfi/indexer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "lint": "eslint .",
    "fmt": "prettier --write .",
    "test": "vitest run",
    "db:generate": "prisma generate",
