    "start": "node dist/index.js"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "@stellar/stellar-sdk": "^17.2.1",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "prisma": "^5.14.0",
    "tsx": "^4.15.0",
    "typescript": "^7.0.2"
  }
}
